rules_version = '2';

// Règles du banc d'essai uniquement. L'émulateur ne sert qu'à vérifier le comportement
// du client — le format des écritures, les horodatages, l'atomicité — pas les règles
// elles-mêmes. Un vrai projet n'aurait jamais ça.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
